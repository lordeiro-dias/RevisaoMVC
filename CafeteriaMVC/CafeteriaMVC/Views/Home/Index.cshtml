<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Cadastrar novo produto</h1>

    <form asp-action="Criar" asp-controller="Home" method="post">
        <label for="nome">Nome do Produto:</label>
        <input id="nome" name="nome" type="text" placeholder="bolo de cenoura..."/>

        <label for="preco">Preço:</label>
        <input id="preco" name="preco" type="number" step="0.01" placeholder="18.99"/>

        <label for="descricao">Descrição:</label>
        <input id="descricao" name="descricao" type="text" placeholder="um bolo com uma cobertura de chocolate..." />

        <button type="submit">Cadastrar</button>
    </form>
</body>
</html>